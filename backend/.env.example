DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
# Fernet key (32 url-safe base64 bytes) encrypting MFA/TOTP secrets at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Falls back to a key derived from DJANGO_SECRET_KEY if unset — set this
# explicitly in production so rotating DJANGO_SECRET_KEY doesn't also break
# everyone's enrolled MFA.
# MFA_ENCRYPTION_KEY=
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://user:pass@localhost:5432/app

# Channel layer for realtime chat (new messages, rail updates, presence) —
# needs a running `redis-server`. See domains/chat/realtime.py.
# REDIS_URL=redis://localhost:6379/1
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Used only by `make seed` (manage.py seed_admin) — not read by the app itself.
DJANGO_SUPERUSER_PASSWORD=change-me

# Sign-in is restricted to this email domain, plus any explicit exceptions.
ALLOWED_LOGIN_DOMAIN=acentriagroup.com
ALLOWED_LOGIN_EMAILS=pknuek@gmail.com

# Used to build links (e.g. password reset) sent by email.
FRONTEND_URL=http://localhost:3000
DEFAULT_FROM_EMAIL=no-reply@acentriagroup.com
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Microsoft Graph app registration for chat calls (creates a Teams meeting
# and returns its join link — see domains/chat/calls.py). Needs an Azure app
# registration with the OnlineMeetings.ReadWrite.All *application* permission,
# with admin consent granted. Calling is disabled with a clear error until
# all three are set.
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
